    "chooseWordHint" : {
      "comment" : "VoiceOver hint on text whose words can be chosen, using the system's gesture names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اسحب لأعلى أو لأسفل لاختيار كلمة، ثم اضغط مرتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Streiche nach oben oder unten, um ein Wort auszuwählen, und tippe dann doppelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up or down to choose a word, then double-tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desliza hacia arriba o hacia abajo para elegir una palabra y, luego, toca dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Balayez vers le haut ou le bas pour choisir un mot, puis touchez deux fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोई शब्द चुनने के लिए ऊपर या नीचे स्वाइप करें, फिर डबल-टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gesek ke atas atau ke bawah untuk memilih kata, lalu ketuk dua kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scorri verso l’alto o verso il basso per scegliere una parola, quindi tocca due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上下にスワイプして単語を選び、ダブルタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "위나 아래로 쓸어넘겨 단어를 선택한 다음 이중 탭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passe o dedo para cima ou para baixo para escolher uma palavra e toque duas vezes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Смахните вверх или вниз, чтобы выбрать слово, затем дважды коснитесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ปัดขึ้นหรือลงเพื่อเลือกคำ แล้วแตะสองครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir sözcük seçmek için yukarı veya aşağı kaydırın, ardından çift dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vuốt lên hoặc xuống để chọn một từ, sau đó chạm hai lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "向上或向下轻扫以选择词语，然后连按两次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "向上或向下滑動來選擇字詞，然後點兩下。"
          }
        }
      }
    },
